{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "esnext",
    "declaration": true,
    "declarationDir": "dist",
    "strict": true,
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "module": "esnext"
  },
  "include": ["src"]
}
