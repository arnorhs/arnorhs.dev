---
import '../styles/fonts.css'
import '../styles/styles.css'
import { pages } from '../lib/data/pages'
import Container from '../components/Container.astro'
import Nav from '../components/nav/Nav.astro'
import NavItem from '../components/nav/Item.astro'
import Favicon from '../components/meta/Favicon.astro'
import { ClientRouter } from 'astro:transitions'

export interface Props {
  title?: string
  animate?: boolean
  ogImage?: string
  ogType?: string
  description?: string
}

const {
  title = undefined,
  ogImage = 'default',
  ogType = 'blog',
  description = `
    Arnor is a software developer and designer hailing from Iceland who writes
    about software development and design
  `,
} = Astro.props as Props

const titleTag = (title ? `${title} - ` : '') + 'arnorhs.dev'

const activePath = (Astro.request.url as unknown as URL).pathname
const fullUrl = Astro.request.url.toString()
const dtUpdated = new Date().toISOString()
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{titleTag}</title>
    <meta name="description" content={description} />
    <meta property="og:image" content={`${Astro.site}og-images/${ogImage}.png`} />
    <meta property="og:title" content={titleTag} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:description" content={description} />
    <meta property="og:updated_time" content={dtUpdated} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@arnorhs" />
    <meta name="twitter:title" content={titleTag} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${Astro.site}og-image/${ogImage}.jpg`} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS Feed for arnorhs.dev"
      href="/rss.xml"
    />

    <Favicon />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <ClientRouter />
  </head>
  <body>
    <div class="px-4 sm:px-8 lg:px-0">
      <header>
        <Container>
          <Nav>
            <NavItem first title="home" href="/">arnorhs</NavItem>

            {
              pages.map(({ slug, shortTitle, title }) => (
                <NavItem href={`/${slug}/`} active={activePath === `/${slug}/`} title={title}>
                  {shortTitle}
                </NavItem>
              ))
            }
          </Nav>
        </Container>
      </header>

      <Container>
        <main class="min-h-screen">
          <slot />
        </main>
      </Container>
    </div>

    <div>
      <footer
        class="mt-20
          px-2
          lg:px-0
          py-6
          bg-arnorhs-900
          dark:bg-arnorhs-100
          border-t
          border-arnorhs-900
          dark:border-arnorhs-200
          text-arnorhs-400
          dark:text-arnorhs-600"
      >
        <Container>
          &copy; Arnór Heiðar Sigurðsson, all rights reserved. - <a
            class="text-inherit underline"
            href="/disclaimer">Disclaimer</a
          >
        </Container>
      </footer>
    </div>
  </body>
</html>

<script>
  const trackPageView = () => {
    console.log('Page loaded, tracking view')
    // Send a non-blocking request to your tracking endpoint
    fetch('/api/view.json', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ path: window.location.pathname, referrer: document.referrer }),
      // We don't care about the response, just fire and forget
      mode: 'no-cors',
    })
  }

  // Ensure this runs only client-side
  document.addEventListener('astro:page-load', () => {
    trackPageView()
  })
</script>
