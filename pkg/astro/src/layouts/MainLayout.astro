---
import '../styles/fonts.css'
import '../styles/styles.css'
import Container from '../components/Container.astro'
import Nav from '../components/nav/Nav.astro'
import NavItem from '../components/nav/Item.astro'
import Favicon from '../components/meta/Favicon.astro'
import JsonLd from '../components/meta/JsonLd.astro'
import { ClientRouter } from 'astro:transitions'
import type { PostWithUrl } from '@arnorhs/posts'

export interface Props {
  title?: string
  ogImage?: string
  ogType?: string
  description?: string
  post?: PostWithUrl
}

const {
  title = undefined,
  ogImage = 'default',
  ogType = 'blog',
  description = `
    Arnor is a software developer and designer hailing from Iceland who writes
    about software development and design
  `,
  post = undefined,
} = Astro.props as Props

function formatTitleTag(rawTitle: string | undefined): string {
  const siteName = 'arnorhs.dev'
  const maxLen = 80

  if (!rawTitle) return siteName

  const cleanTitle = rawTitle.replace(/\s+/g, ' ').trim()
  const withSuffix = `${cleanTitle} - ${siteName}`

  // Ideal: keep full title + suffix when in-range.
  if (withSuffix.length <= maxLen) return withSuffix

  // First fallback: remove suffix.
  if (cleanTitle.length <= maxLen) return cleanTitle

  // Final fallback: truncate title at a word boundary.
  const cutoff = maxLen - 3 // + '...' => maxLen
  let truncated = cleanTitle.substring(0, cutoff)
  const lastSpace = truncated.lastIndexOf(' ')
  if (lastSpace > 50) {
    truncated = truncated.substring(0, lastSpace)
  }

  return truncated + '...'
}

const titleTag = formatTitleTag(title)

const activePath = (Astro.request.url as unknown as URL).pathname
const fullUrl = Astro.request.url.toString()
const dtUpdated = new Date().toISOString()

function formatMetaDescription(desc: string | undefined): string {
  if (!desc) return ''
  // Strip HTML tags
  let clean = desc.replace(/<[^>]*>/g, '')
  // Normalize whitespace/newlines
  clean = clean.replace(/\s+/g, ' ').trim()

  if (clean.length <= 160) {
    return clean
  }

  // Truncate to 157 and add ...
  const maxLen = 157
  let truncated = clean.substring(0, maxLen)
  const lastSpace = truncated.lastIndexOf(' ')
  if (lastSpace > 100) {
    truncated = truncated.substring(0, lastSpace)
  }
  return truncated + '...'
}

const formattedDescription = formatMetaDescription(description)
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{titleTag}</title>
    <meta name="description" content={formattedDescription} />
    <meta property="og:image" content={`${Astro.site}og-images/${ogImage}.png`} />
    <meta property="og:title" content={titleTag} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:description" content={formattedDescription} />
    <meta property="og:updated_time" content={dtUpdated} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@arnorhs" />
    <meta name="twitter:title" content={titleTag} />
    <meta name="twitter:description" content={formattedDescription} />
    <meta name="twitter:image" content={`${Astro.site}og-image/${ogImage}.jpg`} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS Feed for arnorhs.dev"
      href="/rss.xml"
    />

    <Favicon />
    <JsonLd title={titleTag} description={formattedDescription} url={fullUrl} post={post} />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <ClientRouter />
  </head>
  <body>
    <div class="px-4 sm:px-8 lg:px-0">
      <header>
        <Container>
          <Nav>
            <NavItem first title="home" href="/">arnorhs</NavItem>
            <NavItem title="Blog posts archive" href="/archive/" active={activePath === '/archive/'}
              >Posts</NavItem
            >
            <NavItem
              title="Legend of the fountain of wisdom"
              href="/about/"
              active={activePath === '/about/'}>About</NavItem
            >
          </Nav>
        </Container>
      </header>

      <Container>
        <main class="min-h-screen">
          <slot />
        </main>
      </Container>
    </div>

    <div>
      <footer
        class="mt-20
          px-2
          lg:px-0
          py-6
          bg-arnorhs-900
          dark:bg-arnorhs-100
          border-t
          border-arnorhs-900
          dark:border-arnorhs-200
          text-arnorhs-400
          dark:text-arnorhs-600"
      >
        <Container>
          &copy; Arnór Heiðar Sigurðsson, all rights reserved. - <a
            class="text-inherit underline"
            href="/disclaimer/">Disclaimer</a
          >
        </Container>
      </footer>
    </div>
  </body>
</html>

<script>
  import { trackPageView } from '../lib/analytics/trackPageView'

  // Ensure this runs only client-side
  document.addEventListener('astro:page-load', () => {
    trackPageView()
  })
</script>
