---
import { type PostWithUrl } from '@arnorhs/posts'
import Heading from './Heading.astro'

export interface Props {
  post: PostWithUrl
}

const post = Astro.props.post
---

<article class="pt-6" transition:name={post.url}>
  <Heading tag="h2" variation="big">
    <a class="text-arnorhs-primary dark:text-arnorhs-700" href={post.url}
      >{post.title || 'missing title'}</a
    >
  </Heading>

  <p class="text-md mt-2 sm:text-xl font-normal lg:text-base md:w-3/4" set:html={post.summary} />

  <p>
    <a class="text-base font-semibold" href={post.url}>Read on →</a>
  </p>
</article>
