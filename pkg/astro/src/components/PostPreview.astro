---
import { type PostWithUrl } from '@arnorhs/posts'
import Heading from './Heading.astro'
import { dateFormat } from '../lib/dateFormat'

export interface Props {
  post: PostWithUrl
  showByline?: boolean
}

const post = Astro.props.post
const showByline = Astro.props.showByline ?? true
---

<article>
  <Heading tag="h3" variation="dense">
    <a class="text-inherit visited:text-inherit" href={post.url}>{post.title || 'missing title'}</a>
  </Heading>

  {
    showByline && (
      <p class="mt-1 dark:text-arnorhs-700 md:mt-0 text-xs font-normal" aria-label="published date">
        {dateFormat(new Date(post.publishedDate))}
      </p>
    )
  }

  <p class="text-md mt-2 sm:text-xl font-normal lg:text-base" set:html={post.summary} />

  <p>
    <a class="text-base font-semibold" href={post.url}>Read on →</a>
  </p>
</article>
