---
import { type PostWithUrl } from '@arnorhs/posts'
import { dateFormat } from '../lib/dateFormat'

const post = Astro.props.post as PostWithUrl
---

<article>
  <h1
    class="dark:text-arnorhs-700 mb-[0.3em] mt-[0.5em] leading-[1em] text-5xl font-semibold font-display"
  >
    {post.title}
  </h1>
  <p class="mt-0 text-xs text-arnorhs-400" aria-label="published date">
    {dateFormat(new Date(post.publishedDate))}
  </p>

  <div set:html={post.htmlBody} />
</article>
