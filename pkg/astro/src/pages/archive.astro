---
import MainLayout from '../layouts/MainLayout.astro'
import PostPreview from '../components/PostPreview.astro'
import Heading from '../components/Heading.astro'
import Card from '../components/Card.astro'
import { getAllGroupedPosts } from '@arnorhs/posts'
import { dateFormat } from '../lib/dateFormat'

const groupedPosts = await getAllGroupedPosts()
---

<MainLayout title="Blog archive">
  <Heading tag="h1" variation="semi">All posts by arnorhs</Heading>
  <p>
    Follow my updates on Bluesky <a
      href="https://bsky.app/profile/arnorhs.dev"
      target="_blank"
      rel="no-follow">@arnorhs.dev</a
    >.
  </p>
  <p class="mb-10">
    If you use an RSS reader, you can access the <a
      aria-roledescription="RSS feed"
      title="Subscribe to RSS feed"
      href="/rss.xml">RSS feed here</a
    >.
  </p>
  {
    groupedPosts.map(({ year, posts }) => (
      <ol>
        <li>
          <Heading variation="semi" tag="h2">
            {year}
          </Heading>
          {parseInt(year, 10) >= 2012 ? (
            <ol class="lg:grid lg:grid-cols-2 gap-5">
              {posts.map((post) => (
                <li>
                  <Card>
                    <PostPreview post={post} />
                  </Card>
                </li>
              ))}
            </ol>
          ) : (
            <ol>
              {posts.map((post) => (
                <li class="mb-2">
                  <a class="font-semibold text-lg" href={post.url as string}>
                    {post.title}
                  </a>
                  &middot;
                  <span>{dateFormat(new Date(post.publishedDate))}</span>
                </li>
              ))}
            </ol>
          )}
        </li>
      </ol>
    ))
  }
</MainLayout>
