{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "arnorhsdev",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-10-09",
  "compatibility_flags": ["nodejs_compat", "assets_navigation_has_no_effect"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page", // If you have a custom `src/pages/404.astro` page
  },
  "analytics_engine_datasets": [
    {
      "binding": "ARNORHS_ANALYTICS",
      "dataset": "arnorhs-analytics",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
  },
  "services": [
    {
      "binding": "POST_IMAGES_WORKER",
      "service": "arnorhsdev-post-images",
    },
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1",
      "simple": {
        "limit": 100,
        "period": 60,
      },
    },
  ],
}
