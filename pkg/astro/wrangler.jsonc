{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "arnorhsdev",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-10-09",
  "compatibility_flags": [
    "nodejs_compat",
    // So I can navigate to og-urls like /og-images/afffd.png without 404s
    // possibly i should disable this again or disable in prod?
    "assets_navigation_has_no_effect",
    // https://github.com/withastro/astro/issues/14511
    "disable_nodejs_process_v2",
  ],
  "assets": {
    // Required for the 404-page not found handling
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "analytics_engine_datasets": [
    {
      "binding": "ARNORHS_ANALYTICS",
      "dataset": "arnorhs-analytics",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
  },
  "services": [
    {
      "binding": "POST_IMAGES_WORKER",
      "service": "arnorhsdev-post-images",
    },
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1",
      "simple": {
        "limit": 100,
        "period": 60,
      },
    },
  ],
}
